// Grouped sub-property syntax: `name { key: value ... }` desugars to
// `name.key: value` property assignments (equivalent to the dotted form).
#include <firmir/items/Rectangle.hpp>

Rectangle {
    id: root
    width: 100
    height: 80
    color: "#202830"

    border {
        width: 2
        color: "#FF8000"
    }

    Rectangle {
        id: child
        width: 40
        height: 40
        border {
            width: root.width / 50 // expressions/bindings work inside groups
            color: "#00FF00";
        }
    }
}
