// Generated by firmlc from "33_codegen_bindings.fml". Do not edit.
#include "33_codegen_bindings.hpp"

#include <any>
#include <firmir/string.hpp>

F33CodegenBindingsObjects createF33CodegenBindings(Firmir::Gui::Item* parent) {
    F33CodegenBindingsObjects objects;

    auto* root = new Firmir::Gui::Rectangle(parent);
    objects.root = root;
    root->setName("root");
    root->setProperty("width", 400.0);
    root->setProperty("height", 300.0);

    auto* left = new Firmir::Gui::Rectangle(root);
    objects.left = left;
    left->setName("left");
    left->setProperty("width", 40.0);
    left->setProperty("height", 20.0);

    auto* right = new Firmir::Gui::Rectangle(root);
    objects.right = right;
    right->setName("right");
    right->setProperty("height", 20.0);

    auto* badge = new Firmir::Gui::Text(root);
    objects.badge = badge;
    badge->setName("badge");

    auto* forward = new Firmir::Gui::Rectangle(root);
    objects.forward = forward;
    forward->setName("forward");

    auto* late = new Firmir::Gui::Rectangle(root);
    objects.late = late;
    late->setName("late");
    late->setProperty("width", 7.0);

    // bindings
    right->setProperty("width", (Firmir::detail::anyConvert<double>(left->getProperty("width")) * 2.0));
    left->connect<std::string, std::any>(
        right, Firmir::Object::signalPropertyChanged,
        [right, left](const std::string& name, const std::any&) {
            if (name == "width")
                right->setProperty("width", (Firmir::detail::anyConvert<double>(left->getProperty("width")) * 2.0));
        },
        Firmir::ConnectionMode::Direct);
    right->setProperty("x", ((Firmir::detail::anyConvert<double>(root->getProperty("width")) > 300.0) ? 100.0 : 10.0));
    root->connect<std::string, std::any>(
        right, Firmir::Object::signalPropertyChanged,
        [right, root](const std::string& name, const std::any&) {
            if (name == "width")
                right->setProperty("x", ((Firmir::detail::anyConvert<double>(root->getProperty("width")) > 300.0) ? 100.0 : 10.0));
        },
        Firmir::ConnectionMode::Direct);
    badge->setProperty("text", ((Firmir::detail::anyConvert<double>(badge->getProperty("width")) > 100.0) ? Firmir::String("wide") : Firmir::String("narrow")));
    badge->connect<std::string, std::any>(
        badge, Firmir::Object::signalPropertyChanged,
        [badge](const std::string& name, const std::any&) {
            if (name == "width")
                badge->setProperty("text", ((Firmir::detail::anyConvert<double>(badge->getProperty("width")) > 100.0) ? Firmir::String("wide") : Firmir::String("narrow")));
        },
        Firmir::ConnectionMode::Direct);
    forward->setProperty("width", (Firmir::detail::anyConvert<double>(late->getProperty("width")) + 5.0));
    late->connect<std::string, std::any>(
        forward, Firmir::Object::signalPropertyChanged,
        [forward, late](const std::string& name, const std::any&) {
            if (name == "width")
                forward->setProperty("width", (Firmir::detail::anyConvert<double>(late->getProperty("width")) + 5.0));
        },
        Firmir::ConnectionMode::Direct);

    // anchors
    badge->setLeftMargin((Firmir::detail::anyConvert<double>(left->getProperty("width")) / 2.0));
    left->connect<std::string, std::any>(
        badge, Firmir::Object::signalPropertyChanged,
        [badge, left](const std::string& name, const std::any&) {
            if (name == "width")
                badge->setLeftMargin((Firmir::detail::anyConvert<double>(left->getProperty("width")) / 2.0));
        },
        Firmir::ConnectionMode::Direct);
    return objects;
}
