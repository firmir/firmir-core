// Generated by firmlc from "31_codegen_expressions.fml". Do not edit.
#include "31_codegen_expressions.hpp"

#include <any>
#include <firmir/string.hpp>
#include <algorithm>
#include <cmath>
#include <firmir/gui/painter.hpp>

F31CodegenExpressionsObjects createF31CodegenExpressions(Firmir::Gui::Item* parent) {
    F31CodegenExpressionsObjects objects;

    auto* root = new Firmir::Gui::Rectangle(parent);
    objects.root = root;
    root->setName("root");
    root->setProperty("width", (2.0 + (3.0 * 4.0)));
    root->setProperty("height", ((200.0 - 20.0) / 2.0));
    root->setProperty("x", std::fmod(10.0, 4.0));
    root->setProperty("y", (std::min({10.0, 20.0}) + std::max({1.0, 2.0, 3.0})));
    root->setProperty("opacity", ((0.5 > 0.2) ? 1.0 : 0.0));
    root->setProperty("visible", (!false));
    root->setProperty("color", (Firmir::Gui::Color::rgb(0x10, 0x20, 0x30)).lighter());

    auto* child = new Firmir::Gui::Rectangle(root);
    objects.child = child;
    child->setName("child");

    // bindings
    child->setProperty("width", (Firmir::detail::anyConvert<double>(root->getProperty("width")) - 20.0));
    root->connect<std::string, std::any>(
        child, Firmir::Object::signalPropertyChanged,
        [child, root](const std::string& name, const std::any&) {
            if (name == "width")
                child->setProperty("width", (Firmir::detail::anyConvert<double>(root->getProperty("width")) - 20.0));
        },
        Firmir::ConnectionMode::Direct);
    return objects;
}
