#pragma once

#include <firmir/items/Rectangle.hpp>
#include <firmir/items/Button.hpp>

namespace Firmir::Gui { class Item; class Component; }

/// Pointers into the created item tree (owned by the parent).
struct F40HandlersObjects {
    Firmir::Gui::Rectangle* root = nullptr;
    Firmir::Gui::Button* closeButton = nullptr;
};

/// Builds the item tree under @p parent (call before showing the
/// window, on the GUI thread).
F40HandlersObjects createF40Handlers(Firmir::Gui::Item* parent);
=== 40_handlers.cpp ===
// Generated by firmlc from "40_handlers.fml". Do not edit.
#include "40_handlers.hpp"

#include <any>
#include <firmir/string.hpp>
#include <firmir/gui/painter.hpp>
#include <firmir/gui/app.hpp>

F40HandlersObjects createF40Handlers(Firmir::Gui::Item* parent) {
    F40HandlersObjects objects;

    auto* root = new Firmir::Gui::Rectangle(parent);
    objects.root = root;
    root->setName("root");
    root->setProperty("width", 300.0);
    root->setProperty("height", 300.0);
    root->setProperty("color", Firmir::Gui::Color::rgb(0xFF, 0x00, 0x00));

    auto* closeButton = new Firmir::Gui::Button(root);
    objects.closeButton = closeButton;
    closeButton->setName("closeButton");
    closeButton->setProperty("text", Firmir::String("Close btn"));

    // anchors
    closeButton->centerIn(root);

    // onWidthChanged
    root->connect<std::string, std::any>(root, Firmir::Object::signalPropertyChanged, [=](const std::string& name, const std::any&) {
        if (name != "width") return;
        root->update();
    });

    // onSomeSignal
    root->connect<int, Firmir::String>(root, "someSignal", [=](int code, Firmir::String message) {
        (void)code;
        (void)message;
        Firmir::Object::singleton<Firmir::Gui::App>("Firmir.Gui.App")->setTitle(message);
    });

    // onClicked
    closeButton->connect(closeButton, "clicked", [=]() {
        Firmir::Object::singleton<Firmir::Gui::App>("Firmir.Gui.App")->hide();
    });
    return objects;
}
