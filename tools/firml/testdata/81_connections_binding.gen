// Generated by firmlc from "81_connections_binding.fml". Do not edit.
#include "81_connections_binding.hpp"

#include <any>
#include <firmir/string.hpp>
#include <firmir/gui/painter.hpp>
#include <chrono>
#include <firmir/gui/app.hpp>

F81ConnectionsBindingObjects createF81ConnectionsBinding(Firmir::Gui::Item* parent) {
    F81ConnectionsBindingObjects objects;

    auto* root = new Firmir::Gui::Rectangle(parent);
    objects.root = root;
    root->setName("root");
    root->setProperty("width", 200.0);
    root->setProperty("height", 200.0);

    auto* box = new Firmir::Gui::Rectangle(root);
    objects.box = box;
    box->setName("box");
    box->setProperty("width", 50.0);
    box->setProperty("height", 50.0);
    box->setProperty("color", Firmir::Gui::Color::rgb(0x20, 0x40, 0x60));
    box->setProperty("color", Firmir::Gui::Color::rgb(0xFF, 0x80, 0x00));

    auto* grow = new Firmir::Gui::Button(root);
    objects.grow = grow;
    grow->setName("grow");
    grow->setProperty("text", Firmir::String("Grow"));
    grow->setProperty("x", 10.0);
    grow->setProperty("y", 10.0);

    auto* ticker = new Firmir::Timer(root);
    objects.ticker = ticker;
    ticker->setName("ticker");
    ticker->setInterval(std::chrono::milliseconds(static_cast<long long>(500.0)));
    ticker->start();

    // bindings
    box->setProperty("x", (Firmir::detail::anyConvert<double>(root->getProperty("width")) / 2.0));
    root->connect<std::string, std::any>(
        box, Firmir::Object::signalPropertyChanged,
        [box, root](const std::string& name, const std::any&) {
            if (name == "width")
                box->setProperty("x", (Firmir::detail::anyConvert<double>(root->getProperty("width")) / 2.0));
        },
        Firmir::ConnectionMode::Direct);

    // onClicked
    grow->connect(grow, "clicked", [=]() {
        box->setProperty("width", (Firmir::detail::anyConvert<double>(box->getProperty("width")) + 10.0));
        Firmir::Object::singleton<Firmir::Gui::App>("Firmir.Gui.App")->setTitle(Firmir::String("clicked"));
    });

    // onTimeout
    ticker->connect(ticker, "timeout", [=]() {
        root->update();
    });

    // onWidthChanged
    root->connect<std::string, std::any>(root, Firmir::Object::signalPropertyChanged, [=](const std::string& name, const std::any&) {
        if (name != "width") return;
        root->update();
    });
    return objects;
}
