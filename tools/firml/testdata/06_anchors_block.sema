(sema 06_anchors_block.fml
  (symbol root Rectangle 3:1)
  (symbol header Rectangle 8:5)
  (symbol content Rectangle 18:5)
  (set root.width)
  (set root.height)
  (set header.height)
  (anchor header.left parent.left -> root.x)
  (anchor header.right parent.right -> root.x root.width)
  (anchor header.top parent.top -> root.y)
  (anchor content.fill parent -> root.x root.y root.width root.height)
  (anchor content.topMargin -> header.height)
  (anchor content.margins)
)
