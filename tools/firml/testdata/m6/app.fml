#include <firmir/items/Rectangle.hpp>

Firmir.Gui.Rectangle {
    id: root
    width: 100
    height: 50

    Firmir.Gui.Rectangle {
        id: box
        width: root.width / 2
        height: 10
        color: "#336699"

        behavior on height {
            NumberAnimation { duration: 20ms }
        }
    }
}
