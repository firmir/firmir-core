(sema 84_component.fml
  (symbol root Rectangle 6:1)
  (symbol container Rectangle 11:5)
  (symbol badgeComponent Component 16:5)
  (symbol badge Rectangle 19:9)
  (symbol badgeText Text 25:13)
  (symbol badgeButton Button 32:13)
  (symbol spawnButton Button 40:5)
  (set root.width)
  (set root.height)
  (set badge.width)
  (set badge.height)
  (set badge.color)
  (set badgeText.text)
  (set badgeText.color)
  (set badgeButton.text)
  (set spawnButton.text)
  (anchor container.fill parent -> root.x root.y root.width root.height)
  (anchor badgeText.centerIn parent -> badge.x badge.width badge.y badge.height)
  (signal-handler badgeButton.clicked)
  (signal-handler spawnButton.clicked)
)
