// Generated by firmlc from "85_function.fml". Do not edit.
#include "85_function.hpp"

#include <any>
#include <firmir/string.hpp>
#include <firmir/gui/painter.hpp>
#include <functional>

F85FunctionObjects createF85Function(Firmir::Gui::Item* parent) {
    F85FunctionObjects objects;

    auto* root = new Firmir::Gui::Rectangle(parent);
    objects.root = root;
    root->setName("root");
    root->setProperty("width", 400.0);
    root->setProperty("height", 300.0);
    root->setProperty("color", Firmir::Gui::Color::rgb(0x20, 0x20, 0x20));
    root->setProperty("clicks", 0.0);

    auto* title = new Firmir::Gui::Text(root);
    objects.title = title;
    title->setName("title");

    auto* subtitle = new Firmir::Gui::Text(root);
    objects.subtitle = subtitle;
    subtitle->setName("subtitle");
    subtitle->setProperty("y", 30.0);

    auto* btn = new Firmir::Gui::Button(root);
    objects.btn = btn;
    btn->setName("btn");

    // functions
    std::function<Firmir::String(Firmir::String)> root_greet;
    std::function<Firmir::Gui::Color(Firmir::Gui::Color)> root_accent;
    std::function<double()> root_doubleClicks;
    std::function<void(double, double)> root_applySize;
    std::function<Firmir::String()> root_summary;
    std::function<Firmir::String(bool)> root_stateLabel;
    root_greet = [=](Firmir::String name) -> Firmir::String {
        return ((Firmir::String("Hello, ") + name) + Firmir::String("!"));
    };
    root_accent = [=](Firmir::Gui::Color base) -> Firmir::Gui::Color {
        return (base).lighter();
    };
    root_doubleClicks = [=]() -> double {
        return (Firmir::detail::anyConvert<double>(root->getProperty("clicks")) * 2.0);
    };
    root_applySize = [=](double w, double h) {
        root->setProperty("width", w);
        root->setProperty("height", h);
    };
    root_summary = [=]() -> Firmir::String {
        return (root_greet(Firmir::String("count")) + Firmir::String::number(root_doubleClicks()));
    };
    root_stateLabel = [=](bool active) -> Firmir::String {
        return (active ? Firmir::String("on") : Firmir::String("off"));
    };
    title->setProperty("color", root_accent(Firmir::Gui::Color::rgb(0x33, 0x66, 0x99)));
    btn->setProperty("text", root_greet(Firmir::String("World")));

    // bindings
    title->setProperty("text", root_summary());
    root->connect<std::string, std::any>(
        title, Firmir::Object::signalPropertyChanged,
        [title, root_summary, root](const std::string& name, const std::any&) {
            if (name == "clicks")
                title->setProperty("text", root_summary());
        },
        Firmir::ConnectionMode::Direct);
    title->setProperty("x", root_doubleClicks());
    root->connect<std::string, std::any>(
        title, Firmir::Object::signalPropertyChanged,
        [title, root_doubleClicks, root](const std::string& name, const std::any&) {
            if (name == "clicks")
                title->setProperty("x", root_doubleClicks());
        },
        Firmir::ConnectionMode::Direct);
    subtitle->setProperty("text", root_stateLabel((Firmir::detail::anyConvert<double>(root->getProperty("clicks")) > 1.0)));
    root->connect<std::string, std::any>(
        subtitle, Firmir::Object::signalPropertyChanged,
        [subtitle, root_stateLabel, root](const std::string& name, const std::any&) {
            if (name == "clicks")
                subtitle->setProperty("text", root_stateLabel((Firmir::detail::anyConvert<double>(root->getProperty("clicks")) > 1.0)));
        },
        Firmir::ConnectionMode::Direct);

    // onClicked
    btn->connect(btn, "clicked", [=]() {
        root->setProperty("clicks", (Firmir::detail::anyConvert<double>(root->getProperty("clicks")) + 1.0));
        root_applySize(500.0, 400.0);
        title->setProperty("text", root_summary());
        subtitle->setProperty("text", root_stateLabel(false));
    });
    return objects;
}
