(sema 21_sema_parent_refs.fml
  (symbol root Rectangle 4:1)
  (symbol label Text 9:5)
  (symbol panel Rectangle 18:5)
  (set root.width)
  (set root.height)
  (bind label.x -> root.width label.width)
  (set label.y)
  (set label.width)
  (set label.height)
  (set label.text)
  (bind panel.width -> root.width)
  (anchor panel.left parent.left -> root.x)
  (anchor panel.bottom parent.bottom -> root.y root.height)
)
