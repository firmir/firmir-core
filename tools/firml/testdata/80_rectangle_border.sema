(sema 80_rectangle_border.fml
  (symbol root Rectangle 4:1)
  (symbol child Rectangle 13:5)
  (set root.width)
  (set root.height)
  (set root.color)
  (set root.radius)
  (set root.border.color)
  (set root.border.width)
  (set child.width)
  (set child.height)
  (bind child.radius -> root.width)
  (set child.border.width)
  (set child.border.color)
)
