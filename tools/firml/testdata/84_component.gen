// Generated by firmlc from "84_component.fml". Do not edit.
#include "84_component.hpp"

#include <any>
#include <firmir/string.hpp>
#include <firmir/gui/painter.hpp>
#include <firmir/gui/component.hpp>

F84ComponentObjects createF84Component(Firmir::Gui::Item* parent) {
    F84ComponentObjects objects;

    auto* root = new Firmir::Gui::Rectangle(parent);
    objects.root = root;
    root->setName("root");
    root->setProperty("width", 300.0);
    root->setProperty("height", 200.0);

    auto* container = new Firmir::Gui::Rectangle(root);
    objects.container = container;
    container->setName("container");

    auto* spawnButton = new Firmir::Gui::Button(root);
    objects.spawnButton = spawnButton;
    spawnButton->setName("spawnButton");
    spawnButton->setProperty("text", Firmir::String("Spawn"));

    // Component badgeComponent (deferred subtree)
    auto* badgeComponent = new Firmir::Gui::Component(
        [=](Firmir::Gui::Item* parent) -> Firmir::Gui::Item* {

    auto* badge = new Firmir::Gui::Rectangle(parent);
    badge->setName("badge");
    badge->setProperty("width", 100.0);
    badge->setProperty("height", 40.0);
    badge->setProperty("color", Firmir::Gui::Color::rgb(0x33, 0x66, 0x99));

    auto* badgeText = new Firmir::Gui::Text(badge);
    badgeText->setName("badgeText");
    badgeText->setProperty("text", Firmir::String("Badge"));
    badgeText->setProperty("color", Firmir::Gui::Color::rgb(0xFF, 0xFF, 0xFF));

    auto* badgeButton = new Firmir::Gui::Button(badge);
    badgeButton->setName("badgeButton");
    badgeButton->setProperty("text", Firmir::String("Hi"));

    // anchors
    badgeText->centerIn(badge);

    // onClicked
    badgeButton->connect(badgeButton, "clicked", [=]() {
        badgeText->setProperty("text", Firmir::String("clicked"));
    });
            return badge;
        }, root);
    badgeComponent->setName("badgeComponent");
    objects.badgeComponent = badgeComponent;

    // anchors
    container->fill(root);

    // onClicked
    spawnButton->connect(spawnButton, "clicked", [=]() {
        auto* badge1 = badgeComponent->createObject(container);
        badge1->setProperty("color", Firmir::Gui::Color::rgb(0xFF, 0x00, 0x00));
        badgeComponent->createObject(container);
    });
    return objects;
}
