// Generated by firmlc from "30_codegen_basic.fml". Do not edit.
#include "30_codegen_basic.hpp"

#include <any>
#include <firmir/string.hpp>
#include <firmir/gui/painter.hpp>

F30CodegenBasicObjects createF30CodegenBasic(Firmir::Gui::Item* parent) {
    F30CodegenBasicObjects objects;

    auto* root = new Firmir::Gui::Rectangle(parent);
    objects.root = root;
    root->setName("root");
    root->setProperty("width", 400.0);
    root->setProperty("height", 300.0);
    root->setProperty("color", Firmir::Gui::Color::rgb(0x1A, 0x1B, 0x1C));
    root->setProperty("opacity", 0.9);
    root->setProperty("visible", true);
    root->setProperty("enabled", false);

    auto* panel = new Firmir::Gui::Rectangle(root);
    objects.panel = panel;
    panel->setName("panel");
    panel->setProperty("height", 40.0);
    panel->setProperty("color", (Firmir::Gui::Color::rgb(0x40, 0x40, 0x40)).darker());

    auto* caption = new Firmir::Gui::Text(root);
    objects.caption = caption;
    caption->setName("caption");
    caption->setProperty("text", Firmir::String("Panel"));

    auto* _obj_3 = new Firmir::Gui::Rectangle(root);
    _obj_3->setProperty("width", 10.0);
    _obj_3->setProperty("height", 10.0);

    auto* filler = new Firmir::Gui::Rectangle(root);
    objects.filler = filler;
    filler->setName("filler");

    auto* centered = new Firmir::Gui::Rectangle(root);
    objects.centered = centered;
    centered->setName("centered");
    centered->setProperty("width", 20.0);
    centered->setProperty("height", 20.0);

    // anchors
    panel->setAnchorLeft({root, Firmir::Gui::AnchorLine::Left});
    panel->setAnchorRight({root, Firmir::Gui::AnchorLine::Right});
    panel->setAnchorTop({root, Firmir::Gui::AnchorLine::Top});
    panel->setLeftMargin(4.0);
    panel->setRightMargin(4.0);
    caption->setAnchorHorizontalCenter({root, Firmir::Gui::AnchorLine::HorizontalCenter});
    caption->setAnchorVerticalCenter({panel, Firmir::Gui::AnchorLine::VerticalCenter});
    _obj_3->setAnchorLeft({});
    filler->fill(root);
    filler->setMargins(2.0);
    centered->centerIn(root);
    centered->setHorizontalCenterOffset(3.0);
    return objects;
}
