// Generated by firmlc from "80_rectangle_border.fml". Do not edit.
#include "80_rectangle_border.hpp"

#include <any>
#include <firmir/string.hpp>
#include <firmir/gui/painter.hpp>

F80RectangleBorderObjects createF80RectangleBorder(Firmir::Gui::Item* parent) {
    F80RectangleBorderObjects objects;

    auto* root = new Firmir::Gui::Rectangle(parent);
    objects.root = root;
    root->setName("root");
    root->setProperty("width", 100.0);
    root->setProperty("height", 80.0);
    root->setProperty("color", Firmir::Gui::Color::rgb(0x20, 0x28, 0x30));
    root->setProperty("radius", 8.0);
    root->setProperty("border.color", Firmir::Gui::Color::rgb(0xFF, 0x80, 0x00));
    root->setProperty("border.width", 2.0);

    auto* child = new Firmir::Gui::Rectangle(root);
    objects.child = child;
    child->setName("child");
    child->setProperty("width", 40.0);
    child->setProperty("height", 40.0);
    child->setProperty("border.width", (1.0 + 1.0));
    child->setProperty("border.color", Firmir::Gui::Color::rgb(0x00, 0xFF, 0x00));

    // bindings
    child->setProperty("radius", (Firmir::detail::anyConvert<double>(root->getProperty("width")) / 10.0));
    root->connect<std::string, std::any>(
        child, Firmir::Object::signalPropertyChanged,
        [child, root](const std::string& name, const std::any&) {
            if (name == "width")
                child->setProperty("radius", (Firmir::detail::anyConvert<double>(root->getProperty("width")) / 10.0));
        },
        Firmir::ConnectionMode::Direct);
    return objects;
}
