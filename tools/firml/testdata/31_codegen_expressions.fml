// M3 codegen: static expressions (arithmetic, ternary, builtins); one binding
// stays a comment until M4.
#include <firmir/items/Rectangle.hpp>

Rectangle {
    id: root
    width: 2 + 3 * 4
    height: (200 - 20) / 2
    x: 10 % 4
    y: min(10, 20) + max(1, 2, 3)
    opacity: 0.5 > 0.2 ? 1.0 : 0.0
    visible: !false
    color: lighter("#102030")

    Rectangle {
        id: child
        width: root.width - 20
    }
}
