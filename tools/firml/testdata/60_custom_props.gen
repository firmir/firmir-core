// Generated by firmlc from "60_custom_props.fml". Do not edit.
#include "60_custom_props.hpp"

#include <any>
#include <firmir/string.hpp>
#include <firmir/gui/painter.hpp>

F60CustomPropsObjects createF60CustomProps(Firmir::Gui::Item* parent) {
    F60CustomPropsObjects objects;

    auto* root = new Firmir::Gui::Rectangle(parent);
    objects.root = root;
    root->setName("root");
    root->setProperty("toggled", false);
    root->setProperty("width", 200.0);
    root->setProperty("height", 100.0);
    root->setProperty("count", 0.0);
    root->setProperty("tint", (Firmir::Gui::Color::rgb(0x40, 0x40, 0x40)).darker());

    auto* labelText = new Firmir::Gui::Text(root);
    objects.labelText = labelText;
    labelText->setName("labelText");

    auto* bump = new Firmir::Gui::Button(root);
    objects.bump = bump;
    bump->setName("bump");
    bump->setProperty("text", (Firmir::String("+") + Firmir::String::number(1.0)));
    bump->setProperty("y", 50.0);
    bump->setProperty("width", 40.0);
    bump->setProperty("height", 20.0);

    // bindings
    root->setProperty("label", (Firmir::String("count: ") + Firmir::String::number(Firmir::detail::anyConvert<double>(root->getProperty("count")))));
    root->connect<std::string, std::any>(
        root, Firmir::Object::signalPropertyChanged,
        [root](const std::string& name, const std::any&) {
            if (name == "count")
                root->setProperty("label", (Firmir::String("count: ") + Firmir::String::number(Firmir::detail::anyConvert<double>(root->getProperty("count")))));
        },
        Firmir::ConnectionMode::Direct);
    labelText->setProperty("width", Firmir::detail::anyConvert<double>(root->getProperty("width")));
    root->connect<std::string, std::any>(
        labelText, Firmir::Object::signalPropertyChanged,
        [labelText, root](const std::string& name, const std::any&) {
            if (name == "width")
                labelText->setProperty("width", Firmir::detail::anyConvert<double>(root->getProperty("width")));
        },
        Firmir::ConnectionMode::Direct);
    labelText->setProperty("text", Firmir::detail::anyConvert<Firmir::String>(root->getProperty("label")));
    root->connect<std::string, std::any>(
        labelText, Firmir::Object::signalPropertyChanged,
        [labelText, root](const std::string& name, const std::any&) {
            if (name == "label")
                labelText->setProperty("text", Firmir::detail::anyConvert<Firmir::String>(root->getProperty("label")));
        },
        Firmir::ConnectionMode::Direct);
    labelText->setProperty("color", Firmir::detail::anyConvert<Firmir::Gui::Color>(root->getProperty("tint")));
    root->connect<std::string, std::any>(
        labelText, Firmir::Object::signalPropertyChanged,
        [labelText, root](const std::string& name, const std::any&) {
            if (name == "tint")
                labelText->setProperty("color", Firmir::detail::anyConvert<Firmir::Gui::Color>(root->getProperty("tint")));
        },
        Firmir::ConnectionMode::Direct);

    // onCountChanged
    root->connect<std::string, std::any>(root, Firmir::Object::signalPropertyChanged, [=](const std::string& name, const std::any&) {
        if (name != "count") return;
        root->setProperty("toggled", (!Firmir::detail::anyConvert<bool>(root->getProperty("toggled"))));
    });

    // onClicked
    bump->connect(bump, "clicked", [=]() {
        root->setProperty("count", (Firmir::detail::anyConvert<double>(root->getProperty("count")) + 1.0));
        labelText->setProperty("text", ((Firmir::String("clicked ") + Firmir::String::number(Firmir::detail::anyConvert<double>(root->getProperty("count")))) + Firmir::String(" time(s)")));
    });
    return objects;
}
