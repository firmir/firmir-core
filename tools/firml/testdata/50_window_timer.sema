(sema 50_window_timer.fml
  (symbol root Window 7:1)
  (symbol background Rectangle 13:5)
  (symbol box Rectangle 19:5)
  (symbol ticker Timer 31:5)
  (set root.title)
  (bind root.width -> Firmir.Gui.App.screenWidth)
  (set root.height)
  (set background.color)
  (set box.color)
  (bind box.width -> root.width)
  (set box.height)
  (set box.x)
  (set ticker.running)
  (set ticker.singleShot)
  (set ticker.interval)
  (anchor background.fill parent -> root.x root.y root.width root.height)
  (signal-handler ticker.timeout)
  (behavior box.x (NumberAnimation duration=100ms))
)
