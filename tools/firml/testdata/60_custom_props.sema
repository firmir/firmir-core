(sema 60_custom_props.fml
  (symbol root Rectangle 7:1)
  (symbol labelText Text 21:5)
  (symbol bump Button 28:5)
  (set root.width)
  (set root.height)
  (set root.count)
  (bind root.label -> root.count)
  (set root.tint)
  (bind labelText.width -> root.width)
  (bind labelText.text -> root.label)
  (bind labelText.color -> root.tint)
  (set bump.text)
  (set bump.y)
  (set bump.width)
  (set bump.height)
  (property-handler root.count)
  (signal-handler bump.clicked)
)
