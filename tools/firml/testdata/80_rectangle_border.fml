// Rectangle radius / border.color / border.width grouped properties.
#include <firmir/items/Rectangle.hpp>

Rectangle {
    id: root
    width: 100
    height: 80
    color: "#202830"
    radius: 8
    border.color: "#FF8000"
    border.width: 2

    Rectangle {
        id: child
        width: 40
        height: 40
        radius: root.width / 10
        border.width: 1 + 1
        border.color: "#00FF00"
    }
}
