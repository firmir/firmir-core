#include <firmir/items/Rectangle.hpp>
#include <firmir/items/Text.hpp>

Rectangle {
    id: root
    width: 640
    height: 480

    Text {
        id: label
        x: parent.width / 2 - width / 2
        y: 40
        width: 100
        height: 20
        text: "Hello"
    }

    Rectangle {
        id: panel
        width: parent.width / 2
        anchors { left: parent.left; bottom: parent.bottom }
    }
}
