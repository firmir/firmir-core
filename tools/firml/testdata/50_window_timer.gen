#pragma once

#include <firmir/items/Window.hpp>
#include <firmir/items/Rectangle.hpp>
#include <firmir/items/Timer.hpp>

namespace Firmir::Gui { class Item; class Component; class Screen; class App; }

/// Pointers into the created window and object tree (owned
/// by the window).
struct F50WindowTimerObjects {
    Firmir::Gui::Window* root = nullptr;
    Firmir::Gui::Rectangle* background = nullptr;
    Firmir::Gui::Rectangle* box = nullptr;
    Firmir::Timer* ticker = nullptr;
    Firmir::Gui::App* app = nullptr;
};

/// Creates the window on @p screen, builds the object tree and
/// shows the window (call on the GUI thread).
F50WindowTimerObjects createF50WindowTimer(Firmir::Gui::Screen* screen);
