// Generated by firmlc from "50_window_timer.fml". Do not edit.
#include "50_window_timer.hpp"

#include <any>
#include <firmir/string.hpp>
#include <firmir/gui/painter.hpp>
#include <chrono>
#include <firmir/gui/animation.hpp>
#include <firmir/gui/app.hpp>

F50WindowTimerObjects createF50WindowTimer(Firmir::Gui::Screen* screen) {
    F50WindowTimerObjects objects;

    auto* root = new Firmir::Gui::Window(screen);
    objects.root = root;
    root->setName("root");
    root->setProperty("title", Firmir::String("demo"));
    root->setProperty("height", 300.0);

    auto* background = new Firmir::Gui::Rectangle(root->contentItem());
    objects.background = background;
    background->setName("background");
    background->setProperty("color", Firmir::Gui::Color::rgb(0x00, 0x00, 0x00));

    auto* box = new Firmir::Gui::Rectangle(root->contentItem());
    objects.box = box;
    box->setName("box");
    box->setProperty("color", Firmir::Gui::Color::rgb(0xFF, 0x00, 0x00));
    box->setProperty("height", 20.0);
    box->setProperty("x", 5.0);

    auto* ticker = new Firmir::Timer(root->contentItem());
    objects.ticker = ticker;
    ticker->setName("ticker");
    ticker->setSingleShot(false);
    ticker->setInterval(std::chrono::milliseconds(static_cast<long long>(50.0)));
    ticker->start();

    auto* app = new Firmir::Gui::App(root, root);
    Firmir::Object::registerSingleton("Firmir.Gui.App", app);
    objects.app = app;

    // bindings
    root->setProperty("width", (Firmir::detail::anyConvert<double>(Firmir::Object::singleton<Firmir::Gui::App>("Firmir.Gui.App")->getProperty("screenWidth")) / 2.0));
    Firmir::Object::singleton<Firmir::Gui::App>("Firmir.Gui.App")->connect<std::string, std::any>(
        root, Firmir::Object::signalPropertyChanged,
        [root](const std::string& name, const std::any&) {
            if (name == "screenWidth")
                root->setProperty("width", (Firmir::detail::anyConvert<double>(Firmir::Object::singleton<Firmir::Gui::App>("Firmir.Gui.App")->getProperty("screenWidth")) / 2.0));
        },
        Firmir::ConnectionMode::Direct);
    box->setProperty("width", (Firmir::detail::anyConvert<double>(root->getProperty("width")) / 4.0));
    root->connect<std::string, std::any>(
        box, Firmir::Object::signalPropertyChanged,
        [box, root](const std::string& name, const std::any&) {
            if (name == "width")
                box->setProperty("width", (Firmir::detail::anyConvert<double>(root->getProperty("width")) / 4.0));
        },
        Firmir::ConnectionMode::Direct);

    // anchors
    background->fill(root->contentItem());

    // behavior on x
    auto* anim_0 = new Firmir::Gui::NumberAnimation(box);
    anim_0->setDuration(std::chrono::milliseconds(100));
    box->addBehavior("x", anim_0);

    // onTimeout
    ticker->connect(ticker, "timeout", [=]() {
        box->setProperty("x", (Firmir::detail::anyConvert<double>(root->getProperty("width")) - Firmir::detail::anyConvert<double>(box->getProperty("x"))));
        ticker->stop();
    });

    root->show();
    return objects;
}
