// Generated by firmlc from "34_codegen_behavior.fml". Do not edit.
#include "34_codegen_behavior.hpp"

#include <any>
#include <firmir/string.hpp>
#include <firmir/gui/painter.hpp>
#include <chrono>
#include <firmir/gui/animation.hpp>

F34CodegenBehaviorObjects createF34CodegenBehavior(Firmir::Gui::Item* parent) {
    F34CodegenBehaviorObjects objects;

    auto* box = new Firmir::Gui::Rectangle(parent);
    objects.box = box;
    box->setName("box");
    box->setProperty("width", 100.0);
    box->setProperty("height", 100.0);
    box->setProperty("color", Firmir::Gui::Color::rgb(0x00, 0x00, 0x00));

    // behavior on width
    auto* anim_0 = new Firmir::Gui::SequentialAnimation(box);
    auto* anim_1 = new Firmir::Gui::NumberAnimation(anim_0);
    anim_1->setDuration(std::chrono::milliseconds(200));
    anim_1->setEasing(Firmir::Gui::Easing::OutCubic);
    auto* anim_2 = new Firmir::Gui::PauseAnimation(anim_0);
    anim_2->setDuration(std::chrono::milliseconds(50));
    auto* anim_3 = new Firmir::Gui::NumberAnimation(anim_0);
    anim_3->setDuration(std::chrono::milliseconds(100));
    box->addBehavior("width", anim_0);

    // behavior on color
    auto* anim_4 = new Firmir::Gui::ColorAnimation(box);
    anim_4->setDuration(std::chrono::milliseconds(300));
    anim_4->setEasing(Firmir::Gui::Easing::InOutQuad);
    box->addBehavior("color", anim_4);
    return objects;
}
