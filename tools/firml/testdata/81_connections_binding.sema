(sema 81_connections_binding.fml
  (symbol root Rectangle 6:1)
  (symbol box Rectangle 11:5)
  (symbol grow Button 18:5)
  (symbol ticker Timer 25:5)
  (symbol _obj_4 Connections 31:5)
  (symbol _obj_5 Connections 40:5)
  (symbol _obj_6 Connections 46:5)
  (symbol _obj_7 Binding 52:5)
  (symbol _obj_8 Binding 58:5)
  (set root.width)
  (set root.height)
  (set box.width)
  (set box.height)
  (set box.color)
  (set grow.text)
  (set grow.x)
  (set grow.y)
  (set ticker.interval)
  (set ticker.running)
  (bind box.x -> root.width)
  (set box.color)
  (signal-handler grow.clicked)
  (signal-handler ticker.timeout)
  (property-handler root.width)
)
