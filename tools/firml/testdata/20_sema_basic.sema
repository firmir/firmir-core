(sema 20_sema_basic.fml
  (symbol root Rectangle 4:1)
  (symbol header Rectangle 10:5)
  (symbol content Rectangle 16:5)
  (symbol badge Text 21:5)
  (set root.width)
  (set root.height)
  (set root.color)
  (set header.height)
  (bind badge.text -> root.width)
  (anchor header.left parent.left -> root.x)
  (anchor header.right parent.right -> root.x root.width)
  (anchor header.top parent.top -> root.y)
  (anchor content.fill parent -> root.x root.y root.width root.height)
  (anchor content.topMargin -> header.height)
  (anchor badge.centerIn parent -> root.x root.width root.y root.height)
  (anchor badge.verticalCenterOffset)
  (behavior badge.opacity (NumberAnimation duration=300ms easing=OutCubic))
)
