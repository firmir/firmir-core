#include "32_codegen_opaque.hpp"

#include <any>
#include <firmir/string.hpp>

F32CodegenOpaqueObjects createF32CodegenOpaque(Firmir::Gui::Item* parent) {
    F32CodegenOpaqueObjects objects;

    auto* button = new MyButton(parent);
    objects.button = button;
    button->setName("button");
    button->setProperty("width", 120.0);
    button->setProperty("height", 40.0);
    button->setProperty("label", Firmir::String("OK"));
    return objects;
}
