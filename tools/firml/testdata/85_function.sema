(sema 85_function.fml
  (symbol root Rectangle 8:1)
  (symbol title Text 45:5)
  (symbol subtitle Text 52:5)
  (symbol btn Button 58:5)
  (set root.width)
  (set root.height)
  (set root.color)
  (set root.clicks)
  (bind title.text -> root.clicks)
  (bind title.x -> root.clicks)
  (set title.color)
  (bind subtitle.text -> root.clicks)
  (set subtitle.y)
  (set btn.text)
  (signal-handler btn.clicked)
  (function root.greet (string name) -> String)
  (function root.accent (color base) -> Color)
  (function root.doubleClicks -> Number deps: root.clicks)
  (function root.applySize (number w) (number h) -> void)
  (function root.summary -> String deps: root.clicks)
  (function root.stateLabel (bool active) -> String)
)
