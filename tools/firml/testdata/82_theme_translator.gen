// Generated by firmlc from "82_theme_translator.fml". Do not edit.
#include "82_theme_translator.hpp"

#include <any>
#include <firmir/string.hpp>
#include <firmir/gui/painter.hpp>
#include <firmir/gui/theme.hpp>
#include <firmir/translator.hpp>

F82ThemeTranslatorObjects createF82ThemeTranslator(Firmir::Gui::Item* parent) {
    F82ThemeTranslatorObjects objects;

    auto* root = new Firmir::Gui::Rectangle(parent);
    objects.root = root;
    root->setName("root");
    root->setProperty("width", 400.0);
    root->setProperty("height", 300.0);

    auto* label = new Firmir::Gui::Text(root);
    objects.label = label;
    label->setName("label");

    auto* schemeLabel = new Firmir::Gui::Text(root);
    objects.schemeLabel = schemeLabel;
    schemeLabel->setName("schemeLabel");
    schemeLabel->setProperty("x", 10.0);
    schemeLabel->setProperty("y", 60.0);

    auto* accentButton = new Firmir::Gui::Button(root);
    objects.accentButton = accentButton;
    accentButton->setName("accentButton");
    accentButton->setProperty("x", 10.0);
    accentButton->setProperty("y", 100.0);

    // bindings
    root->setProperty("color", Firmir::detail::anyConvert<Firmir::Gui::Color>(Firmir::Gui::Theme::instance()->getProperty("darkPrimaryColor")));
    Firmir::Gui::Theme::instance()->connect<std::string, std::any>(
        root, Firmir::Object::signalPropertyChanged,
        [root](const std::string& name, const std::any&) {
            if (name == "darkPrimaryColor")
                root->setProperty("color", Firmir::detail::anyConvert<Firmir::Gui::Color>(Firmir::Gui::Theme::instance()->getProperty("darkPrimaryColor")));
        },
        Firmir::ConnectionMode::Direct);
    label->setProperty("x", Firmir::detail::anyConvert<double>(Firmir::Gui::Theme::instance()->getProperty("horizontalPageMargin")));
    Firmir::Gui::Theme::instance()->connect<std::string, std::any>(
        label, Firmir::Object::signalPropertyChanged,
        [label](const std::string& name, const std::any&) {
            if (name == "horizontalPageMargin")
                label->setProperty("x", Firmir::detail::anyConvert<double>(Firmir::Gui::Theme::instance()->getProperty("horizontalPageMargin")));
        },
        Firmir::ConnectionMode::Direct);
    label->setProperty("y", Firmir::detail::anyConvert<double>(Firmir::Gui::Theme::instance()->getProperty("paddingMedium")));
    Firmir::Gui::Theme::instance()->connect<std::string, std::any>(
        label, Firmir::Object::signalPropertyChanged,
        [label](const std::string& name, const std::any&) {
            if (name == "paddingMedium")
                label->setProperty("y", Firmir::detail::anyConvert<double>(Firmir::Gui::Theme::instance()->getProperty("paddingMedium")));
        },
        Firmir::ConnectionMode::Direct);
    label->setProperty("fontSize", Firmir::detail::anyConvert<double>(Firmir::Gui::Theme::instance()->getProperty("fontSizeLarge")));
    Firmir::Gui::Theme::instance()->connect<std::string, std::any>(
        label, Firmir::Object::signalPropertyChanged,
        [label](const std::string& name, const std::any&) {
            if (name == "fontSizeLarge")
                label->setProperty("fontSize", Firmir::detail::anyConvert<double>(Firmir::Gui::Theme::instance()->getProperty("fontSizeLarge")));
        },
        Firmir::ConnectionMode::Direct);
    label->setProperty("color", Firmir::detail::anyConvert<Firmir::Gui::Color>(Firmir::Gui::Theme::instance()->getProperty("primaryColor")));
    Firmir::Gui::Theme::instance()->connect<std::string, std::any>(
        label, Firmir::Object::signalPropertyChanged,
        [label](const std::string& name, const std::any&) {
            if (name == "primaryColor")
                label->setProperty("color", Firmir::detail::anyConvert<Firmir::Gui::Color>(Firmir::Gui::Theme::instance()->getProperty("primaryColor")));
        },
        Firmir::ConnectionMode::Direct);
    label->setProperty("text", Firmir::Translator::instance()->trId(Firmir::String("hello-text")));
    Firmir::Translator::instance()->connect<std::string, std::any>(
        label, Firmir::Object::signalPropertyChanged,
        [label](const std::string& name, const std::any&) {
            if (name == "language")
                label->setProperty("text", Firmir::Translator::instance()->trId(Firmir::String("hello-text")));
        },
        Firmir::ConnectionMode::Direct);
    schemeLabel->setProperty("color", Firmir::detail::anyConvert<Firmir::Gui::Color>(Firmir::Gui::Theme::instance()->getProperty("secondaryColor")));
    Firmir::Gui::Theme::instance()->connect<std::string, std::any>(
        schemeLabel, Firmir::Object::signalPropertyChanged,
        [schemeLabel](const std::string& name, const std::any&) {
            if (name == "secondaryColor")
                schemeLabel->setProperty("color", Firmir::detail::anyConvert<Firmir::Gui::Color>(Firmir::Gui::Theme::instance()->getProperty("secondaryColor")));
        },
        Firmir::ConnectionMode::Direct);
    schemeLabel->setProperty("text", Firmir::detail::anyConvert<Firmir::String>(Firmir::Gui::Theme::instance()->getProperty("colorScheme")));
    Firmir::Gui::Theme::instance()->connect<std::string, std::any>(
        schemeLabel, Firmir::Object::signalPropertyChanged,
        [schemeLabel](const std::string& name, const std::any&) {
            if (name == "colorScheme")
                schemeLabel->setProperty("text", Firmir::detail::anyConvert<Firmir::String>(Firmir::Gui::Theme::instance()->getProperty("colorScheme")));
        },
        Firmir::ConnectionMode::Direct);
    accentButton->setProperty("text", Firmir::Translator::instance()->trId(Firmir::String("accent-button")));
    Firmir::Translator::instance()->connect<std::string, std::any>(
        accentButton, Firmir::Object::signalPropertyChanged,
        [accentButton](const std::string& name, const std::any&) {
            if (name == "language")
                accentButton->setProperty("text", Firmir::Translator::instance()->trId(Firmir::String("accent-button")));
        },
        Firmir::ConnectionMode::Direct);

    // onClicked
    accentButton->connect(accentButton, "clicked", [=]() {
        Firmir::Gui::Theme::instance()->setProperty("highlightColor", Firmir::Gui::Color::rgb(0xFF, 0xA0, 0x00));
    });
    return objects;
}
