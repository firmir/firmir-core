// First real Firmir app: a red 300x300 window (Wayland backend) with a
// centered greeting drawn with the built-in bitmap font.
#include <firmir/items/Rectangle.hpp>
#include <firmir/items/Text.hpp>

Firmir.Gui.Rectangle {
    id: root
    width: 300
    height: 300
    color: "#FF0000"

    Firmir.Gui.Text {
        text: "Hello, Firml!"
        color: "#FFFFFF"
        fontSize: 16
        anchors.centerIn: parent
    }
}
