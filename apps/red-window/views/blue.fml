#include <firmir/items/Rectangle.hpp>
#include <firmir/items/Text.hpp>
#include <firmir/items/Button.hpp>
using FGRectangle = Firmir.Gui.Rectangle
using FGText = Firmir.Gui.Text

FGRectangle {
    id: root
    width: 300
    height: 300
    color: "#204080"

    FGText {
        text: "Second view"
        color: "#FFFFFF"
        fontSize: 24
        anchors.centerIn: parent
    }

    Firmir.Gui.Button {
        text: "Close blue view"
        fontSize: 16
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        anchors.bottomMargin: 20
        onClicked: { Firmir.Gui.App.hide() }
    }
}
