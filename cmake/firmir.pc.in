# Relocatable: the prefix is derived from the .pc file's own location, so an
# install tree can be moved (or staged with --prefix/DESTDIR) freely.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@FIRMIR_INSTALL_LIBDIR@
includedir=${prefix}/@FIRMIR_INSTALL_INCLUDEDIR@

Name: firmir-@FIRMIR_PC_MODULE@
Description: Firmir @FIRMIR_PC_MODULE@ library
Version: @PROJECT_VERSION@
Requires: @FIRMIR_PC_REQUIRES@
Libs: -L${libdir} -l@FIRMIR_PC_TARGET@
Cflags: -I${includedir}
