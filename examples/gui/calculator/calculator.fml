// firmir-gui calculator: the whole UI *and* the calculator logic are declared
// in Firml and compiled to C++ by firmlc at build time (see CMakeLists.txt);
// main.cpp only picks the screen and runs the event loop.
//
// State lives in script-declared dynamic properties on the root window; every
// write emits propertyChanged, so the display binding re-evaluates itself.
// The 20 keys are declared once in a ListModel and instantiated by a Repeater
// into a 4x5 Grid; the single delegate handler dispatches on the key roles.
#include <firmir/items/Window.hpp>
#include <firmir/items/Rectangle.hpp>
#include <firmir/items/Text.hpp>
#include <firmir/items/Button.hpp>
#include <firmir/items/Grid.hpp>
#include <firmir/items/Repeater.hpp>
#include <firmir/items/ListModel.hpp>
#include <firmir/items/ListElement.hpp>

Firmir.Gui.Window {
    id: root
    title: "Calculator"
    width: 340
    height: 506

    // ------------------------- calculator state -------------------------
    property number acc: 0      // accumulated result / left operand
    property number entry: 0    // the value currently being typed
    property number dot: 0      // decimal divisor while typing the fraction (0 = integer part)
    property number op: 0       // pending operation: 0 none, 1 +, 2 -, 3 *, 4 /
    property bool fresh: true   // the next digit starts a new entry
    property bool editing: true // the display shows `entry` (false: shows `acc`)

    // --------------------------- layout metrics --------------------------
    property number gap: 8
    property number barH: 36      // window-controls strip at the top
    property number displayH: 80
    property number colW: (width - 5 * gap) / 4
    property number rowH: (height - barH - displayH - 7 * gap) / 5

    // ------------------------------ key model ----------------------------
    // Roles: text (label), digit (0-9 or -1), fn (1 clear, 2 sign, 3 percent,
    // 4 backspace, 5 decimal point, 6 equals, 7 operator), op (pending
    // operation for fn == 7), bg/fg (colors).
    ListModel {
        id: keys
        ListElement { text: "C" digit: -1 fn: 1 op: 0 bg: "#8e8e96" fg: "#101012" }
        ListElement { text: "+/-" digit: -1 fn: 2 op: 0 bg: "#8e8e96" fg: "#101012" }
        ListElement { text: "%" digit: -1 fn: 3 op: 0 bg: "#8e8e96" fg: "#101012" }
        ListElement { text: "/" digit: -1 fn: 7 op: 4 bg: "#ff9f0a" fg: "#ffffff" }
        ListElement { text: "7" digit: 7 fn: 0 op: 0 bg: "#505054" fg: "#ffffff" }
        ListElement { text: "8" digit: 8 fn: 0 op: 0 bg: "#505054" fg: "#ffffff" }
        ListElement { text: "9" digit: 9 fn: 0 op: 0 bg: "#505054" fg: "#ffffff" }
        ListElement { text: "*" digit: -1 fn: 7 op: 3 bg: "#ff9f0a" fg: "#ffffff" }
        ListElement { text: "4" digit: 4 fn: 0 op: 0 bg: "#505054" fg: "#ffffff" }
        ListElement { text: "5" digit: 5 fn: 0 op: 0 bg: "#505054" fg: "#ffffff" }
        ListElement { text: "6" digit: 6 fn: 0 op: 0 bg: "#505054" fg: "#ffffff" }
        ListElement { text: "-" digit: -1 fn: 7 op: 2 bg: "#ff9f0a" fg: "#ffffff" }
        ListElement { text: "1" digit: 1 fn: 0 op: 0 bg: "#505054" fg: "#ffffff" }
        ListElement { text: "2" digit: 2 fn: 0 op: 0 bg: "#505054" fg: "#ffffff" }
        ListElement { text: "3" digit: 3 fn: 0 op: 0 bg: "#505054" fg: "#ffffff" }
        ListElement { text: "+" digit: -1 fn: 7 op: 1 bg: "#ff9f0a" fg: "#ffffff" }
        ListElement { text: "0" digit: 0 fn: 0 op: 0 bg: "#505054" fg: "#ffffff" }
        ListElement { text: "." digit: -1 fn: 5 op: 0 bg: "#505054" fg: "#ffffff" }
        ListElement { text: "⌫" digit: -1 fn: 4 op: 0 bg: "#505054" fg: "#ffffff" }
        ListElement { text: "=" digit: -1 fn: 6 op: 0 bg: "#ff9f0a" fg: "#ffffff" }
    }

    Rectangle {
        anchors.fill: parent
        color: "#1c1c1e"
    }

    Rectangle {
        id: displayBg
        x: root.gap
        y: root.gap + root.barH
        width: parent.width - 2 * root.gap
        height: root.displayH
        color: "#000000"
    }

    Text {
        id: display
        x: root.gap + 12
        y: root.gap + root.barH + (root.displayH - 40) / 2
        width: displayBg.width - 24
        height: 40
        fontSize: 34
        color: "#ffffff"
        text: root.editing ? "" + root.entry : "" + root.acc
    }

    Grid {
        id: keypad
        columns: 4
        spacing: root.gap
        x: root.gap
        y: root.displayH + root.barH + 2 * root.gap

        Repeater {
            model: keys
            Button {
                text: model.text
                fontSize: 22
                width: root.colW
                height: root.rowH
                color: pressed ? darker(model.bg) : model.bg
                textColor: model.fg
                onClicked: {
                    root.acc = model.fn == 6 ? (root.op == 0 ? root.acc : (root.op == 1 ? root.acc + root.entry : (root.op == 2 ? root.acc - root.entry : (root.op == 3 ? root.acc * root.entry : root.acc / root.entry)))) : (model.fn == 7 ? (root.op == 0 ? root.entry : (root.op == 1 ? root.acc + root.entry : (root.op == 2 ? root.acc - root.entry : (root.op == 3 ? root.acc * root.entry : root.acc / root.entry)))) : (model.fn == 1 ? 0 : ((model.fn == 2 && !root.editing) ? -root.acc : ((model.fn == 3 && !root.editing) ? root.acc / 100 : root.acc))))
                    root.entry = model.digit >= 0 ? (root.fresh ? model.digit : (root.dot > 0 ? root.entry + model.digit / root.dot : root.entry * 10 + model.digit)) : (model.fn == 1 ? 0 : (model.fn == 5 ? (root.fresh ? 0 : root.entry) : (model.fn == 4 ? (root.editing ? (root.dot > 0 ? root.entry - root.entry % (100 / (root.dot > 10 ? root.dot : 100)) : (root.entry - root.entry % 10) / 10) : root.entry) : ((model.fn == 6 || model.fn == 7) ? 0 : ((model.fn == 2 && root.editing) ? -root.entry : ((model.fn == 3 && root.editing) ? root.entry / 100 : root.entry))))))
                    root.dot = model.digit >= 0 ? (root.dot > 0 ? root.dot * 10 : root.dot) : (model.fn == 5 ? (root.dot > 0 ? root.dot : 10) : (model.fn == 4 ? (root.dot > 10 ? root.dot / 10 : 0) : ((model.fn == 1 || model.fn == 6 || model.fn == 7) ? 0 : root.dot)))
                    root.op = model.fn == 7 ? model.op : ((model.fn == 1 || model.fn == 6) ? 0 : root.op)
                    root.fresh = (model.digit >= 0 || model.fn == 2 || model.fn == 3 || model.fn == 4 || model.fn == 5) ? false : true
                    root.editing = (model.digit >= 0 || model.fn == 1 || model.fn == 4 || model.fn == 5) ? true : ((model.fn == 6 || model.fn == 7) ? false : root.editing)
                }
            }
        }
    }

    // Window controls in the top strip (declared last: they paint on top).
    Button {
        id: closeButton
        text: "X"
        width: 36
        height: 28
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.rightMargin: 4
        anchors.topMargin: 4
        onClicked: Firmir.Gui.App.close()
    }

    Button {
        id: maximizeButton
        text: "[]"
        width: 36
        height: 28
        anchors.right: closeButton.left
        anchors.top: parent.top
        anchors.rightMargin: 4
        anchors.topMargin: 4
        onClicked: Firmir.Gui.App.toggleMaximized()
    }

    Button {
        id: minimizeButton
        text: "_"
        width: 36
        height: 28
        anchors.right: maximizeButton.left
        anchors.top: parent.top
        anchors.rightMargin: 4
        anchors.topMargin: 4
        onClicked: Firmir.Gui.App.showMinimized()
    }
}

