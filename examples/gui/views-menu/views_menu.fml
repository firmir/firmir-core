// views-menu example: the whole UI *and* the view-switching logic are
// declared in Firml and compiled to C++ by firmlc at build time; main.cpp
// only picks the screen and runs the event loop.
//
// The menu is a ListModel rendered by a Repeater into a Column; the delegate
// handler toggles the views' `visible` property by the row index.
#include <firmir/items/Window.hpp>
#include <firmir/items/Rectangle.hpp>
#include <firmir/items/Text.hpp>
#include <firmir/items/Button.hpp>
#include <firmir/items/Column.hpp>
#include <firmir/items/Repeater.hpp>
#include <firmir/items/ListModel.hpp>
#include <firmir/items/ListElement.hpp>

Firmir.Gui.Window {
    id: root
    title: "views-menu"

    // Density-independent metrics: baseMm is 1 mm in pixels (ppcm is pixels
    // per centimetre, so a tenth of it is one millimetre; 96 ppi is the
    // fallback when the backend does not report the panel size).
    property number baseMm: root.ppcm > 0 ? root.ppcm / 10 : 3.7795
    // fit is how much of the screen the window covers (Window.uiScale),
    // floored at 3/4 so the text stays readable in a small window: the menu
    // keeps its proportions in a window smaller than the screen.
    property number fit: root.uiScale < 0.75 ? 0.75 : root.uiScale
    property number mm: root.baseMm * root.fit

    // Sized in millimetres, so the window is as large on a dense panel as it
    // is on a 96 ppi display (400x300 px there).
    width: 106 * baseMm
    height: 79 * baseMm

    property number ctrlWidth: 9 * mm
    property number ctrlHeight: 7 * mm
    property number ctrlMargin: 1.5 * mm
    property number ctrlFont: 3.2 * mm

    ListModel {
        id: viewList
        ListElement {
            title: "Greeting"
        }
        ListElement {
            title: "Palette"
        }
        ListElement {
            title: "About"
        }
    }

    Rectangle {
        anchors.fill: parent
        color: "#202830"
    }

    // ------------------------------- views --------------------------------
    // (declared before the menu so the delegate handlers can reference them)

    Rectangle {
        id: greetingView
        x: menu.x + menu.width + 4 * root.mm
        y: root.ctrlHeight + 3 * root.mm
        width: parent.width - x - 4 * root.mm
        height: parent.height - y - 4 * root.mm
        color: "#C0392B"
        Text {
            text: "Hello, Firml!"
            color: "#FFFFFF"
            fontSize: root.ctrlFont * 1.6
            anchors.centerIn: parent
        }
    }

    Rectangle {
        id: paletteView
        x: greetingView.x
        y: greetingView.y
        width: greetingView.width
        height: greetingView.height
        color: "#204080"
        visible: false
        Text {
            text: "Second view"
            color: "#FFFFFF"
            fontSize: root.ctrlFont * 2.2
            anchors.centerIn: parent
        }
    }

    Rectangle {
        id: aboutView
        x: greetingView.x
        y: greetingView.y
        width: greetingView.width
        height: greetingView.height
        color: "#30363F"
        visible: false
        Text {
            text: "views-menu: FML logic"
            color: "#FFFFFF"
            fontSize: root.ctrlFont * 1.3
            anchors.centerIn: parent
        }
    }

    Column {
        id: menu
        x: 4 * root.mm
        y: 4 * root.mm
        width: 29 * root.mm
        spacing: 2 * root.mm

        Text {
            text: "Views"
            color: "#FFFFFF"
            fontSize: root.ctrlFont * 1.6
            width: menu.width
            height: 7 * root.mm
        }

        Repeater {
            model: viewList
            Button {
                width: menu.width
                height: 9 * root.mm
                text: model.title
                fontSize: root.ctrlFont
                color: pressed ? "#50627A" : "#3A4A5C"
                textColor: "#FFFFFF"
                onClicked: {
                    greetingView.visible = index == 0
                    paletteView.visible = index == 1
                    aboutView.visible = index == 2
                }
            }
        }
    }

    // Window controls (declared last: they paint on top).
    Button {
        id: closeButton
        text: "X"
        width: root.ctrlWidth
        height: root.ctrlHeight
        fontSize: root.ctrlFont
        anchors {
            right: parent.right
            top: parent.top
            rightMargin: root.ctrlMargin
            topMargin: root.ctrlMargin
        }
        onClicked: Firmir.Gui.App.close()
    }

    Button {
        id: maximizeButton
        text: "[]"
        width: root.ctrlWidth
        height: root.ctrlHeight
        fontSize: root.ctrlFont
        anchors {
            right: closeButton.left
            top: parent.top
            rightMargin: root.ctrlMargin
            topMargin: root.ctrlMargin
        }
        onClicked: Firmir.Gui.App.toggleMaximized()
    }

    Button {
        id: minimizeButton
        text: "_"
        width: root.ctrlWidth
        height: root.ctrlHeight
        fontSize: root.ctrlFont
        anchors {
            right: maximizeButton.left
            top: parent.top
            rightMargin: root.ctrlMargin
            topMargin: root.ctrlMargin
        }
        onClicked: Firmir.Gui.App.showMinimized()
    }
}
