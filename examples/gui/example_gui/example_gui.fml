// firmir-gui example: the whole UI is declared in Firml and compiled to C++
// by firmlc at build time (see CMakeLists.txt); main.cpp only picks the
// screen and runs the event loop.
//
// A red rectangle (a quarter of the window) sits on a black background; a
// timer flips its position every 100 ms and the behaviors animate the move.
#include <firmir/items/Window.hpp>
#include <firmir/items/Rectangle.hpp>
#include <firmir/items/Button.hpp>
#include <firmir/items/Timer.hpp>

Firmir.Gui.Window {
    id: root
    title: "firmir-gui example"
    // Half of the primary screen; re-evaluated on screen hotplug.
    width: Firmir.Gui.App.screenWidth / 2
    height: Firmir.Gui.App.screenHeight / 2

    Firmir.Gui.Rectangle {
        anchors.fill: parent
        color: "#000000"
    }

    Firmir.Gui.Rectangle {
        id: mainRect

        color: "#FF0000"
        width: parent.width / 4
        height: parent.height / 4
        x: parent.width / 4
        y: parent.height / 4

        behavior on x {
            NumberAnimation {
                duration: 500ms
            }
        }

        behavior on y {
            NumberAnimation {
                duration: 500ms
            }
        }
    }

    Timer {
        id: mainTimer
        running: true
        singleShot: false
        interval: 1000

        onTimeout: {
            mainRect.x = root.width * 0.75 - mainRect.x
            mainRect.y = root.height * 0.75 - mainRect.y
        }
    }

    // Window controls (declared last: they paint on top).
    Button {
        id: closeButton
        text: "X"
        width: 36
        height: 28
        anchors {
            right: parent.right
            top: parent.top
            rightMargin: 4
            topMargin: 4
        }
        onClicked: Firmir.Gui.App.close()
    }

    Button {
        id: maximizeButton
        text: "[]"
        width: 36
        height: 28
        anchors {
            right: closeButton.left
            top: parent.top
            rightMargin: 4
            topMargin: 4
        }
        onClicked: Firmir.Gui.App.toggleMaximized()
    }

    Button {
        id: minimizeButton
        text: "_"
        width: 36
        height: 28
        anchors {
            right: maximizeButton.left
            top: parent.top
            rightMargin: 4
            topMargin: 4
        }
        onClicked: Firmir.Gui.App.showMinimized()
    }
}
