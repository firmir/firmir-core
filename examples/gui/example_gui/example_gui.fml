// firmir-gui example: the whole UI is declared in Firml and compiled to C++
// by firmlc at build time (see CMakeLists.txt); main.cpp only picks the
// screen and runs the event loop.
//
// A red rectangle (a quarter of the window) sits on a black background; a
// timer flips its position every 100 ms and the behaviors animate the move.
#include <firmir/items/Window.hpp>
#include <firmir/items/Rectangle.hpp>
#include <firmir/items/Button.hpp>
#include <firmir/items/Timer.hpp>

Firmir.Gui.Window {
    id: root
    title: "firmir-gui example"
    // Half of the primary screen; re-evaluated on screen hotplug.
    width: Firmir.Gui.App.screenWidth / 2
    height: Firmir.Gui.App.screenHeight / 2

    // Density-independent metrics: 1 mm in pixels. root.ppcm is pixels per
    // centimetre, so a tenth of it is one millimetre. A finger needs a ~9 mm
    // target: ~34 px on a 96 ppi display, ~106 px on a dense tablet panel, and
    // the window controls below stay tappable on both. root.ppcm is 0 when the
    // backend does not report the panel size, so fall back to 96 ppi
    // (3.7795 px/mm); every binding re-evaluates when the window moves to
    // another screen.
    property number mm: root.ppcm > 0 ? root.ppcm / 10 : 3.7795
    property number ctrlWidth: 9 * mm
    property number ctrlHeight: 7 * mm
    property number ctrlMargin: 1.5 * mm
    property number ctrlFont: 3.2 * mm

    Firmir.Gui.Rectangle {
        anchors.fill: parent
        color: "#000000"
    }

    Firmir.Gui.Rectangle {
        id: mainRect

        color: "#FF0000"
        width: parent.width / 4
        height: parent.height / 4
        x: parent.width / 4
        y: parent.height / 4

        behavior on x {
            NumberAnimation {
                duration: 500ms
            }
        }

        behavior on y {
            NumberAnimation {
                duration: 500ms
            }
        }
    }

    Timer {
        id: mainTimer
        running: true
        singleShot: false
        // Same as the animation duration below, so the next move starts when
        // the previous one ends and the rectangle moves continuously. A longer
        // interval (e.g. FIRMIR_EXAMPLE_TIMER_MS=1000) leaves the window idle
        // between moves and shows the cold-start gap.
        interval: 500

        onTimeout: {
            mainRect.x = root.width * 0.75 - mainRect.x
            mainRect.y = root.height * 0.75 - mainRect.y
        }
    }

    // Window controls (declared last: they paint on top).
    Button {
        id: closeButton
        text: "X"
        width: root.ctrlWidth
        height: root.ctrlHeight
        fontSize: root.ctrlFont
        anchors {
            right: parent.right
            top: parent.top
            rightMargin: root.ctrlMargin
            topMargin: root.ctrlMargin
        }
        onClicked: Firmir.Gui.App.close()
    }

    Button {
        id: maximizeButton
        text: "[]"
        width: root.ctrlWidth
        height: root.ctrlHeight
        fontSize: root.ctrlFont
        anchors {
            right: closeButton.left
            top: parent.top
            rightMargin: root.ctrlMargin
            topMargin: root.ctrlMargin
        }
        onClicked: Firmir.Gui.App.toggleMaximized()
    }

    Button {
        id: minimizeButton
        text: "_"
        width: root.ctrlWidth
        height: root.ctrlHeight
        fontSize: root.ctrlFont
        anchors {
            right: maximizeButton.left
            top: parent.top
            rightMargin: root.ctrlMargin
            topMargin: root.ctrlMargin
        }
        onClicked: Firmir.Gui.App.showMinimized()
    }
}
